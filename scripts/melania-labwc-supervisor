#!/usr/bin/env bash
# Thin session environment bootstrap. Child supervision/restart policy lives
# in the Rust melania-session-supervisor, not a fragile shell polling loop.
set -euo pipefail
: "${MELANIA_ROOT:?}"
: "${MELANIA_BIN_DIR:?}"
: "${MELANIA_CONTROL_SOCKET:?}"
: "${WAYLAND_DISPLAY:?}"
: "${LABWC_PID:?}"
BIN="$MELANIA_BIN_DIR"

# The portal environment belongs only to this private Melania login.
# Nested previews must not modify the host systemd user manager.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP || true
  if [[ "${MELANIA_NESTED_SESSION:-0}" != 1 ]]; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP || true
  fi
fi
if [[ ! -x "$BIN/melania-session-supervisor" ]]; then
  echo 'MELANIA_LABWC_FATAL=rust_supervisor_missing' >&2
  # Never leave a real login running without any shell or lock daemon.
  if [[ "$LABWC_PID" =~ ^[0-9]+$ && "$LABWC_PID" -gt 1 &&
        -r "/proc/$LABWC_PID/comm" &&
        "$(cat "/proc/$LABWC_PID/comm")" == labwc &&
        "$(stat -c %u "/proc/$LABWC_PID")" == "$(id -u)" ]]; then
    kill -TERM "$LABWC_PID" 2>/dev/null || true
  fi
  exit 78
fi

exec "$BIN/melania-session-supervisor"
