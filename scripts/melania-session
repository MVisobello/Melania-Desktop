#!/usr/bin/env bash
# Safe entry point for the current Melania compositor.
# This build uses Smithay's winit backend: a host display is mandatory.
set -euo pipefail
SCRIPT="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
usage='Usage: melania-session --nested | --nested-software | --check-native | --probe-native'
case "$#" in
  1) ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
case "$1" in
  --nested|--nested-software)
    if ! env | grep -Eq "^(DISPLAY|WAYLAND_DISPLAY)=.+"; then
      echo 'BLOCKED: the current Melania compositor needs a running Linux graphical session.' >&2
      echo 'Use the nested preview from an existing desktop, not from a login manager.' >&2
      exit 78
    fi
    if [[ "$1" == '--nested-software' ]]; then
      # VirtualBox may expose EGL while GTK fails to initialize Zink/DRI.
      # Keep this explicit and opt-in: do not degrade native GPU defaults.
      export GSK_RENDERER=cairo
      export LIBGL_ALWAYS_SOFTWARE=1
      echo 'MELANIA_NESTED_SOFTWARE_RENDERER: GSK_RENDERER=cairo LIBGL_ALWAYS_SOFTWARE=1' >&2
    fi
    exec /usr/bin/env bash "$ROOT/scripts/run-melania-v018-nested.sh"
    ;;
  --check-native)
    echo 'NATIVE_BACKEND_UNAVAILABLE: current compositor initializes smithay::backend::winit.' >&2
    echo 'No DRM/KMS + libseat/logind backend, VT/input lifecycle or tested native session yet.' >&2
    exit 78
    ;;
  --probe-native)
    exec python3 "$ROOT/scripts/probe-native-session.py" --json
    ;;
  *)
    echo "$usage" >&2
    exit 2
    ;;
esac
